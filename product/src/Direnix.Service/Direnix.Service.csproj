<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>Direnix.Service</AssemblyName>
    <RootNamespace>Direnix.Service</RootNamespace>
    <Version>0.9.2</Version>
    <!-- Embute o wwwroot no assembly para o modo portátil (single-file): o exe
         sozinho serve o portal, sem depender de uma pasta wwwroot no disco. -->
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="8.0.11" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="wwwroot\**\*" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Direnix.Core\Direnix.Core.csproj" />
    <ProjectReference Include="..\Direnix.Infrastructure\Direnix.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="DirenixPortal.url" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Always" />
  </ItemGroup>
</Project>
